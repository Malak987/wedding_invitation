rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin = an authenticated user carrying an `admin` custom claim.
    // Enable this for the couple by creating a Firebase Auth user and
    // setting its custom claim { admin: true } via the Admin SDK, e.g.:
    //   admin.auth().setCustomUserClaims(uid, { admin: true })
    // The dashboard and the live "guests confirmed" counter read the
    // normalized guestResponses collection, so they only work once an
    // admin is signed in. Public (anonymous) visitors cannot list/get
    // guest documents — this keeps names, messages and device ids private.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isRsvpBaseValid() {
      return request.resource.data.keys().hasAll([
        'eventId',
        'guestId',
        'guestName',
        'attendanceStatus',
        'guestCount',
        'message',
        'language',
        'deviceId',
        'createdAt'
      ])
      && request.resource.data.keys().hasOnly([
        'eventId',
        'guestId',
        'guestName',
        'attendanceStatus',
        'guestCount',
        'message',
        'language',
        'deviceId',
        'createdAt',
        'updatedAt',
        'notificationsEnabled',
        'fcmToken',
        'reminderSchedule',
        'notificationsUpdatedAt'
      ])
      && request.resource.data.eventId is string
      && request.resource.data.guestId is string
      && request.resource.data.guestName is string
      && request.resource.data.attendanceStatus in ['attending', 'declined', 'pending']
      && request.resource.data.guestCount is int
      && request.resource.data.message is string
      && request.resource.data.language is string
      && request.resource.data.deviceId is string
      && request.resource.data.eventId.size() <= 80
      && request.resource.data.guestId.size() <= 120
      && request.resource.data.guestName.size() <= 160
      && request.resource.data.message.size() <= 500
      && request.resource.data.language.size() <= 8
      && request.resource.data.deviceId.size() <= 160
      && (
        (request.resource.data.attendanceStatus == 'attending'
          && request.resource.data.guestCount >= 1
          && request.resource.data.guestCount <= 5)
        ||
        (request.resource.data.attendanceStatus == 'declined'
          && request.resource.data.guestCount == 0)
        ||
        (request.resource.data.attendanceStatus == 'pending'
          && request.resource.data.guestCount == 0)
      );
    }

    // RSVP feature: one collection only, one document per guest.
    // - Guests (anonymous) can create/update their own deterministic
    //   response document, but can never list or read other guests.
    // - Only admins can read the collection (powers the live dashboard).
    // No aggregate/stats document exists: every figure is computed
    // client-side from these documents by RsvpStatsCubit.
    match /guestResponses/{responseId} {
      allow list, get: if isAdmin();
      allow create, update: if isRsvpBaseValid();
      allow delete: if isAdmin();
    }

    // Existing comments feature from the current site. Keep write-only behavior.
    match /comments/{commentId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'siteId', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.message is string
        && request.resource.data.siteId is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.message.size() <= 1000
        && request.resource.data.siteId.size() <= 80;
    }
  }
}
